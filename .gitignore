# 机密：绝不可进入公开仓库
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# 系统与临时
.DS_Store
*.log
_*.html
node_modules/

# 工具产物
.agents/
skills-lock.json

# 本地测试数据 —— 绝不进仓库
data/events.local.json
data/*.local.json

# 部署产物（由 deploy.sh 生成）
public/
.wrangler/

# Cloudflare 本地开发用密钥（wrangler pages dev 读取）
.dev.vars
.dev.vars.*

# 机器人抓取的候选队列体积会增长，本地跑时不要误提交半成品
# （正式产物由 GitHub Actions 提交，见 .github/workflows/collect.yml）

# 由 deploy.sh 生成的候选日期索引
data/candidates/index.json

# sqlgate 的依赖只在本地容器里用，不进仓库
bot/sqlgate/node_modules/
bot/sqlgate/package*.json

__pycache__/
*.pyc
